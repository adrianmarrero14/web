---
/** The AM_ monogram: Archivo 800, tracked tight, closed by an accent underscore. */
interface Props {
  size?: string;
  cursor?: 'static' | 'blink' | 'none';
}
const { size = '32px', cursor = 'static' } = Astro.props;
---

<span class="monogram" style={`font-size: ${size}`}>
  AM{cursor !== 'none' && <span class:list={['cursor', { blink: cursor === 'blink' }]} aria-hidden="true" />}
</span>

<style>
  .monogram {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-heading);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.08em;
  }

  .cursor {
    display: inline-block;
    width: 0.42em;
    height: 0.09em;
    margin-left: 0.06em;
    background: var(--accent);
    transform: translateY(-0.02em);
  }

  .blink {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blink {
      animation: none;
    }
  }
</style>
