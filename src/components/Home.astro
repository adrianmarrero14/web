---
import { Image } from 'astro:assets';
import profile from '../assets/profile.jpeg';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Section from './Section.astro';
import { projects, site, stack, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="page">
  <Header lang={lang} />

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="prompt mono"><span class="accent">$</span> <span data-type="70">whoami</span></p>
        <h1 data-type="55">Adrián<br />Marrero</h1>
        <p class="role" data-type="24">{t('hero.role')}</p>
        <p class="lead">{t('hero.lead')}</p>
      </div>
      <div class="portrait">
        <Image src={profile} alt={t('hero.portrait')} width={400} height={400} loading="eager" />
        <span class="portrait-bar" aria-hidden="true"></span>
      </div>
      <span class="rule" style="--rule-delay: 0.6s" aria-hidden="true"></span>
    </section>

    <Section id="about" index="01" title={t('about.title')} note={t('about.note')}>
      <div class="prose" data-reveal style="--i: 1">
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
        <p>{t('about.p3')}</p>
      </div>
    </Section>

    <Section id="projects" index="02" title={t('projects.title')} note={t('projects.note')}>
      <ul class="projects">
        {
          projects.map((p, i) => (
            <li data-reveal style={`--i: ${i + 1}`}>
              <a href={p.href}>
                <span class="project-name">
                  {p.name} <span class="arrow accent" aria-hidden="true">↗</span>
                </span>
                <span class="project-body">{p.body[lang]}</span>
                <span class="project-status mono">
                  <span class="accent" aria-hidden="true">●</span> {p.status[lang]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="stack" index="03" title={t('stack.title')} note={t('stack.note')}>
      <dl class="stack">
        {
          stack.map(({ group, items }, i) => (
            <div class="stack-cell" data-reveal style={`--i: ${i + 1}`}>
              <dt class="mono">{group[lang]}</dt>
              <dd>
                {items.map((item) => (
                  <span>{typeof item === 'string' ? item : item[lang]}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <Section id="contact" index="04" title={t('contact.title')} note={t('contact.note')}>
      <div data-reveal style="--i: 1">
        <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <ul class="socials mono">
        {
          site.socials.map((s, i) => (
            <li data-reveal style={`--i: ${i + 2}`}>
              <a href={s.href} rel="me">
                <span class="social-label">{s.label}</span>
                <span class="social-handle">{s.handle}</span>
                <span class="arrow accent" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </Section>
  </main>

  <Footer lang={lang} />
</div>

<script>
  // Type the hero's [data-type] lines one after another, like a terminal. The value is
  // milliseconds per character. Screen readers get the full text from the start.
  const targets = [...document.querySelectorAll<HTMLElement>('[data-type]')];

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  function splitChars(node: Node, chars: HTMLElement[]) {
    for (const child of [...node.childNodes]) {
      if (child.nodeType !== Node.TEXT_NODE) {
        splitChars(child, chars);
        continue;
      }
      const spans = [...(child.textContent ?? '')].map((c) => {
        const span = document.createElement('span');
        span.className = 'type-char';
        span.textContent = c;
        chars.push(span);
        return span;
      });
      child.replaceWith(...spans);
    }
  }

  async function type() {
    const cursor = document.createElement('span');
    cursor.className = 'type-cursor';
    cursor.setAttribute('aria-hidden', 'true');

    // Split everything up front so the whole hero keeps its final layout while typing.
    const jobs = targets.map((el) => {
      const original = [...el.childNodes].map((n) => n.cloneNode(true));
      const copy = el.cloneNode(true) as HTMLElement;
      copy.querySelectorAll('br').forEach((br) => br.replaceWith(' '));
      const label = document.createElement('span');
      label.className = 'visually-hidden';
      label.textContent = copy.textContent;
      const visual = document.createElement('span');
      visual.setAttribute('aria-hidden', 'true');
      visual.append(...el.childNodes);
      const chars: HTMLElement[] = [];
      splitChars(visual, chars);
      el.append(label, visual);
      el.dataset.typing = '';
      return { el, original, chars, speed: Number(el.dataset.type) };
    });

    for (const [n, job] of jobs.entries()) {
      job.chars[0].before(cursor);
      await sleep(n === 0 ? 400 : 200);
      for (const char of job.chars) {
        char.classList.add('on');
        char.after(cursor);
        await sleep(job.speed);
      }
      // Back to the plain text, so kerning and selection behave as if nothing happened.
      job.el.replaceChildren(...job.original);
    }

    jobs[jobs.length - 1].el.append(cursor);
    cursor.classList.add('done');
  }

  if (document.documentElement.classList.contains('motion') && targets.length) type();
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: 40px;
    padding-top: clamp(48px, 8vw, 104px);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  .prompt {
    font-size: 14px;
    color: var(--color-muted);
  }

  h1 {
    font-size: clamp(56px, 11vw, 136px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .role {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(18px, 2vw, 22px);
    letter-spacing: -0.01em;
  }

  .lead {
    max-width: 46ch;
    font-size: 18px;
    color: var(--color-muted);
  }

  .portrait {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 400px;
  }

  .portrait img {
    width: 100%;
    filter: grayscale(1);
    /* Fade the photo's edges into the page so its own black never shows as a box. */
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 35%), linear-gradient(to bottom, transparent 0%, black 25%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, black 35%), linear-gradient(to bottom, transparent 0%, black 25%);
    mask-composite: intersect;
  }

  .portrait-bar {
    position: absolute;
    left: 36%;
    bottom: 24px;
    width: 40px;
    height: 6px;
    background: var(--accent);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 64ch;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
  }

  .stack-cell {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    align-items: baseline;
    gap: 8px 24px;
    padding: 18px 20px;
    background: var(--color-surface);
  }

  .stack dt {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .stack dd {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.35;
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projects a {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 8px 24px;
    padding: 18px 20px;
    background: var(--color-surface);
    text-decoration: none;
  }

  .project-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
  }

  .project-body {
    color: var(--color-muted);
    transition: color 120ms ease;
  }

  .projects a:hover .project-body {
    color: var(--color-text);
  }

  .project-status {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .email {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(24px, 4.6vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
    text-decoration: none;
    box-shadow: inset 0 -0.08em 0 var(--accent);
    transition:
      color 120ms ease,
      box-shadow 200ms var(--ease-out);
  }

  .email:hover {
    box-shadow: inset 0 -0.16em 0 var(--accent);
  }

  .socials {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 32px 0 0;
    padding: 0;
    max-width: 560px;
    list-style: none;
    font-size: 14px;
  }

  .socials a {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr) auto;
    gap: 16px;
    padding: 14px 16px;
    background: var(--color-surface);
    text-decoration: none;
  }

  .social-label {
    color: var(--color-muted);
  }

  .socials a:hover .social-label {
    color: inherit;
  }

  .social-handle {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Hover: rows get an accent edge, arrows nudge toward where they lead. */
  .projects a,
  .socials a {
    transition:
      color 120ms ease,
      box-shadow 200ms var(--ease-out);
  }

  .projects a:hover,
  .socials a:hover {
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .arrow {
    display: inline-block;
    transition: transform 200ms var(--ease-out);
  }

  a:hover .arrow {
    transform: translate(2px, -2px);
  }

  /* Hero entrance, timed against the typing in the script above (about 2.7s in total). */
  :global(.motion) .lead {
    animation: hero-rise 0.8s var(--ease-out) 2.2s both;
  }

  :global(.motion) .portrait img {
    animation: portrait-in 1.6s var(--ease-out) 0.2s both;
  }

  :global(.motion) .portrait-bar {
    transform-origin: left;
    animation: bar-grow 0.6s var(--ease-out) 1.5s both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes portrait-in {
    from {
      opacity: 0;
      transform: scale(1.03);
    }
  }

  @keyframes bar-grow {
    from {
      transform: scaleX(0);
    }
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .hero-copy {
      padding-bottom: 32px;
    }

    .portrait {
      justify-self: start;
      max-width: 320px;
    }

    .portrait img {
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 70%, transparent 100%);
      -webkit-mask-composite: source-over;
      mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 70%, transparent 100%);
      mask-composite: add;
    }

    .portrait-bar {
      left: 0;
      bottom: 0;
    }

    .stack-cell,
    .projects a {
      grid-template-columns: minmax(0, 1fr);
    }

    .socials a {
      grid-template-columns: 80px minmax(0, 1fr) auto;
      gap: 12px;
    }
  }
</style>
